# Non-secret AWS runtime contract. Do not place passwords or tokens here.
SPRING_PROFILES_ACTIVE=aws
APP_RUNTIME_MODE=application
SPRING_DATASOURCE_URL=jdbc:mysql://replace-with-private-rds-endpoint:3306/webtutorial
AWS_REGION=replace-with-aws-region
APP_STORAGE_TYPE=s3
APP_STORAGE_S3_BUCKET=replace-with-private-upload-bucket
APP_STORAGE_S3_PREFIX=uploads/images
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
APP_SHUTDOWN_TIMEOUT=30s

# Inject these from Secrets Manager; values are intentionally absent:
# SPRING_DATASOURCE_USERNAME
# SPRING_DATASOURCE_PASSWORD
# JWT_SECRET_BASE64
