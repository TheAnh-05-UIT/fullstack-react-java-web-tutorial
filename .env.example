# Copy this file to .env and replace every change-me/replace-with placeholder.
# The dev Spring profile reads this file automatically.
# Port 3307 is for the Docker MySQL service. Use 3306 for a locally installed MySQL.
# Generate the JWT value with: openssl rand -base64 64
# PowerShell alternative:
# [Convert]::ToBase64String((1..64 | ForEach-Object { Get-Random -Maximum 256 }))
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=webtutorial
MYSQL_USER=webtutorial_app
MYSQL_PASSWORD=change-me
DB_PORT=3307

JWT_SECRET_BASE64=replace-with-64-byte-base64-secret

CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://localhost:5173

# Admin creation is opt-in. Leave credentials empty while disabled.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
