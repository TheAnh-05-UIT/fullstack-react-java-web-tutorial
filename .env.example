# --- Database Config ---
MYSQL_DATABASE=webtutorial
DB_USERNAME=root

MYSQL_ROOT_PASSWORD=change_me_strong_password

# --- Security Config ---
#   openssl rand -base64 64
JWT_SECRET=replace_with_a_strong_base64_secret

# --- CORS Allowed Origins ---
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://localhost:5173

# --- Admin Default Account ---
ADMIN_DEFAULT_EMAIL=your_admin_email@example.com
ADMIN_DEFAULT_PASSWORD=your_strong_admin_password
